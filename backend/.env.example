# Copy this file to .env and fill in real values. Never commit .env.

# Anthropic API key (sk-ant-...)
ANTHROPIC_API_KEY=

# ElevenLabs API key (sk_...) — Creator tier or higher is required for Agents
ELEVENLABS_API_KEY=

# The ElevenLabs Agent id, from the agent you created in their dashboard
ELEVENLABS_AGENT_ID=

# Shared secret the side panel must send when calling /get-signed-url.
# Generate one with: openssl rand -hex 32
# Must match the SHARED_SECRET constant in extension/side-panel/side-panel.js
SHARED_SECRET=

# Comma-separated list of chrome-extension://<id> origins allowed to call the backend.
# Get the id by loading the extension at chrome://extensions and copying it.
EXTENSION_ORIGINS=

# Port to listen on
PORT=8787

# Anthropic model to use
ANTHROPIC_MODEL=claude-sonnet-4-5
